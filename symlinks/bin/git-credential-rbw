#!/usr/bin/env bash

set -euo pipefail

PROTOCOL=""
HOST=""
USERNAME=""
while read line
do
	key="$(echo "$line" | cut -d = -f1)"
	val="$(echo "$line" | cut -d = -f2)"
	case $key in
		protocol)
			PROTOCOL="$val"
			;;
		host)
			HOST="$val"
			;;
		username)
			USERNAME="$val"
			;;
	esac
done < /dev/stdin

PASSWORD="$(rbw get "$HOST" "$USERNAME")"

echo "protocol=$PROTOCOL"
echo "host=$HOST"
echo "username=$USERNAME"
echo "password=$PASSWORD"
